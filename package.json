{
  "name": "vscodesim",
  "displayName": "vscodesim",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscodesim.openSimulator",
        "title": "iOS Simulator: Open Panel"
      }
    ],
    "configuration": {
      "title": "iOS Simulator",
      "properties": {
        "vscodesim.simulator.backend": {
          "type": "string",
          "enum": [
            "auto",
            "sidecar",
            "companion",
            "cli"
          ],
          "enumDescriptions": [
            "Prefer the native simhelper sidecar, then idb_companion, then the idb CLI.",
            "Always use the native simhelper sidecar (correct H.264 video, in-process HID). Fails if the binary is missing.",
            "Always use the idb_companion gRPC backend (low-latency input and video). Fails if idb_companion is not installed.",
            "Always use the idb command-line backend."
          ],
          "default": "auto",
          "description": "How the simulator panel connects to booted simulators for video and input."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1"
  }
}
