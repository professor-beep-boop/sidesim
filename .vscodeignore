# Sources and build inputs — the compiled output (out/) and staged binary
# (bin/simhelper) are what ship.
src/**
sidecar/**
scripts/**
proto/README.md

# Bundled into out/extension.js by esbuild — not shipped loose.
node_modules/**
out/test/**
esbuild.js

# Dev/CI/tooling
.claude/**
.github/**
# Self-hosted runner install — holds .credentials / .credentials_rsaparams
# (the runner's registration secret + private key). MUST never ship in the VSIX.
actions-runner/**
.vscode/**
.vscode-test/**
.vscode-test.mjs
.eslintrc.json
tsconfig.json
**/*.map
**/tsconfig.tsbuildinfo
.gitignore
.vscodeignore

# Keep in the VSIX (documented here for the next reader):
#   out/**            compiled extension
#   bin/simhelper     universal sidecar binary (built by scripts/build-sidecar.sh)
#   media/*.js,*.css  webview assets
#   proto/idb.proto   loaded at runtime by the companion backend
#   README.md, CHANGELOG.md, package.json
